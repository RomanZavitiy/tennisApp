# Environment variables for MatchFinder Kraków.
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is gitignored — never commit real keys, tokens or database URLs.
#
# This file holds only variable names with placeholders. Each task that
# introduces a new variable adds it here, with a one-line comment on what it
# is for and where to get it, e.g.:
#
#   # Supabase project URL (Dashboard → Project Settings → API)
#   EXAMPLE_VARIABLE=your-value-here
#
# Variables the deployed app needs are also set in Vercel (Project Settings →
# Environment Variables), never in git. Each comment says where it goes.

# Supabase Postgres (Dashboard → Connect → ORMs → Prisma). Region: eu-west-1.
# Pooled connection (transaction pooler, port 6543) — used by the app at runtime.
# Vercel: Preview + Production.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct connection (session pooler, port 5432) — used by Prisma migrations.
# Local only: not set in Vercel, deploys don't run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Supabase API (Dashboard → Project Settings → API Keys / Data API).
# Public by design: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, so changing them needs a redeploy. Vercel: Preview + Production.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key — bypasses RLS. Only for the e2e login helper (task 1.18), never
# imported by app code. Local only (and GitHub Actions secrets once e2e runs
# in CI): not set in Vercel.
SUPABASE_SECRET_KEY="sb_secret_..."
