# Environment variables for MatchFinder Kraków.
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is gitignored — never commit real keys, tokens or database URLs.
#
# This file holds only variable names with placeholders. Each task that
# introduces a new variable adds it here, with a one-line comment on what it
# is for and where to get it, e.g.:
#
#   # Supabase project URL (Dashboard → Project Settings → API)
#   EXAMPLE_VARIABLE=your-value-here

# Supabase Postgres (Dashboard → Connect → ORMs → Prisma). Region: eu-west-1.
# Pooled connection (transaction pooler, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct connection (session pooler, port 5432) — used by Prisma migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
