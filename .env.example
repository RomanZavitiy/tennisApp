# Environment variables for MatchFinder Kraków.
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is gitignored — never commit real keys, tokens or database URLs.
#
# This file holds only variable names with placeholders. Each task that
# introduces a new variable adds it here, with a one-line comment on what it
# is for and where to get it, e.g.:
#
#   # Supabase project URL (Dashboard → Project Settings → API)
#   EXAMPLE_VARIABLE=your-value-here
#
# Variables the deployed app needs are also set in Vercel (Project Settings →
# Environment Variables), never in git. Each comment says where it goes.

# Supabase Postgres (Dashboard → Connect → ORMs → Prisma). Region: eu-west-1.
# Pooled connection (transaction pooler, port 6543) — used by the app at runtime.
# Vercel: Preview + Production.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct connection (session pooler, port 5432) — used by Prisma migrations.
# Local only: not set in Vercel, deploys don't run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Supabase API (Dashboard → Project Settings → API Keys / Data API).
# Public by design: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, so changing them needs a redeploy. Vercel: Preview + Production.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key — bypasses RLS. Only for the e2e login helper (task 1.18), never
# imported by app code. Local only (and GitHub Actions secrets once e2e runs
# in CI): not set in Vercel.
SUPABASE_SECRET_KEY="sb_secret_..."

# A long random string (task 5.8) — /api/cron checks it against the
# Authorization header, so only Vercel's own Cron Jobs, the hourly GitHub
# Actions workflow (task 5.10/5.16, same secret as a repo secret — Settings →
# Secrets and variables → Actions), or a human running the command below can
# trigger it. Generate one with `openssl rand -hex 32`. Vercel: Preview +
# Production.
CRON_SECRET="a-long-random-string"

# Resend (resend.com → API Keys) — the account already exists; the key goes
# here. Without a verified domain, Resend only delivers to the account
# owner's own address (decision 2026-09-24) — expected until task 5.13.
# Vercel: Preview + Production.
RESEND_API_KEY="re_..."

# Web push (task 5.15). Generate the VAPID key pair with:
#   pnpm dlx web-push generate-vapid-keys
# Do not commit the output — paste the two keys below and into Vercel
# (Preview + Production). VAPID_SUBJECT is a contact the push services can
# reach about this key, "mailto:" plus an address you own.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@example.com"
# Same value as VAPID_PUBLIC_KEY, inlined into the browser bundle for
# `pushManager.subscribe()` (NEXT_PUBLIC_*, see the note above). Vercel:
# Preview + Production.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."

# Signs the no-login "unsubscribe from email" link (task 5.3) — a
# self-generated secret, the same kind CRON_SECRET already is, not a
# third-party credential. Generate one with `openssl rand -hex 32`. Vercel:
# Preview + Production.
UNSUBSCRIBE_SECRET="a-long-random-string"

# PostHog EU project (posthog.com → Project Settings → API Keys), task 6.5/
# 6.6. Server-only (lib/analytics/posthog.ts) — every event fires from a
# server action, never the browser, so there is no client SDK and nothing
# it could put in a cookie (decision 2026-10-14, "Аналітика: PostHog EU без
# cookie"; see decisions.md 2026-10-16 for why that's a server key here, not
# a client-side `persistence: 'memory'` setting). Without it, events are
# silently skipped. Vercel: Preview + Production.
POSTHOG_KEY="phc_..."
# Defaults to the EU ingestion host already — only set this to override it
# (e.g. a self-hosted PostHog). Vercel: Preview + Production, if set at all.
POSTHOG_HOST="https://eu.i.posthog.com"

# Sentry (sentry.com, free plan) — task 6.19. DSN from Project Settings →
# Client Keys; separate client/server values are the same string, Sentry's
# convention is just to name them differently by where they're read.
# Vercel: Preview + Production.
SENTRY_DSN="https://...@...ingest.de.sentry.io/..."
NEXT_PUBLIC_SENTRY_DSN="https://...@...ingest.de.sentry.io/..."
# Build-time only (next.config.ts's withSentryConfig): uploads source maps
# so a minified stack trace resolves to real file/line. From Sentry's
# organization settings (org/project slugs) and Settings → Auth Tokens
# (needs project:releases scope). Vercel: Preview + Production — set on the
# build environment, never read at runtime.
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
SENTRY_AUTH_TOKEN="sntrys_..."
