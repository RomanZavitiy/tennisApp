// Database schema. Models are added by the tasks that need them.
// Connection URLs live in prisma.config.ts (CLI) and lib/db.ts (runtime).
//
// Conventions (see .agents/decisions.md, task 0.12):
// - Tables, columns and enums are snake_case in Postgres (@@map / @map), so
//   the SQL we write by hand (RLS policies, Supabase dashboard) needs no quotes.
// - Ids and timestamps have database defaults, so rows inserted outside Prisma
//   (SQL editor, seeds) get them too. User.id is the exception: it is the
//   Supabase auth.users id.
// - Timestamps are timestamptz: stored as UTC, shown in Europe/Warsaw.
// - Every foreign key has an index — Postgres doesn't create one for it.
//
// Started as a skeleton (keys, relations, statuses); domain fields come with
// their own tasks: profile 1.10 (done), club 2.1 (done), offer 3.2/3.10, result 4.4.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A player. One row per Supabase Auth account, created on first sign-in (task 1.9).
model User {
  /// Same value as auth.users.id — set by the app, never generated here.
  /// No foreign key to auth.users: Prisma manages only the public schema.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Profile (task 1.10). The row exists from the first sign-in (1.9), before
  // onboarding, so every field is nullable here; the profile schema (1.11)
  // makes them required. A CHECK in the migration guarantees that a user with
  // onboardingCompletedAt set has all of them.
  name                  String?   @db.VarChar(50)
  /// Private: only the age derived from it is ever shown.
  birthDate             DateTime? @map("birth_date") @db.Date
  gender                Gender?
  district              District?
  /// Self-declared NTRP, 1.5–7.0 in steps of 0.5 (CHECK in the migration).
  /// Halves are exact in floating point, so no Decimal is needed. Becomes
  /// the starting point for the ELO rating in Epic 4.
  selfRatedNtrp         Float?    @map("self_rated_ntrp")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz
  /// Path of the profile photo in the "avatars" Storage bucket, always inside
  /// the user's own folder: "{id}/{random}.{ext}" (task 1.14; CHECK in the
  /// migration). Null until a photo is uploaded.
  avatarPath            String?   @map("avatar_path") @db.VarChar(200)

  // Rating (task 4.2). Set from selfRatedNtrp at onboarding (startingElo,
  // 4.1) and re-set when NTRP changes, until the first confirmed match;
  // from then on only confirmed results move it (4.8). CHECKs in the
  // migration: positive, and set for every onboarded user.
  elo           Int?
  /// Confirmed matches played; 0 means the ELO is still the starting one.
  matchesPlayed Int  @default(0) @map("matches_played")

  // Reliability (tasks 4.10-4.12, decision 2026-10-14 "Надійність гравця").
  // All three are counters, not derived from current state: an accepted
  // join later withdrawn no longer shows ACCEPTED, and no history table
  // records a late cancellation at all, so a query couldn't reconstruct
  // either — same reasoning that already made matchesPlayed a counter.
  /// A singles join reaching ACCEPTED counts as scheduled, win or not —
  /// the reliability percentage's denominator.
  scheduledMatches  Int @default(0) @map("scheduled_matches")
  /// Confirmed no-shows against this player (4.10) — a disputed report
  /// never reaches this counter.
  noShows           Int @default(0) @map("no_shows")
  /// Cancelling an offer, or withdrawing an accepted join, less than 12h
  /// before the start (isLateCancellation, lib/rating/reliability.ts).
  lateCancellations Int @default(0) @map("late_cancellations")

  offers         SparringOffer[]
  joins          OfferJoin[]
  sentMessages   Message[]
  outboundClicks OutboundClick[]

  @@map("users")
}

/// A tennis club with courts. Filled from hand-checked data (tasks 2.1–2.3).
model Club {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Club fields (task 2.1). Ranges and formats are CHECKs in the migration;
  // the club schema (2.3) validates the data file first.
  /// Stable key from the data file: loading the file again updates the same
  /// row instead of adding a copy (2.3). Lowercase words joined by hyphens.
  slug       String        @unique @db.VarChar(60)
  name       String        @db.VarChar(100)
  address    String        @db.VarChar(200)
  /// Empty for clubs just outside the city limits (Liszki, Giebułtów).
  district   District?
  latitude   Float
  longitude  Float
  courtCount Int           @map("court_count")
  /// Every surface the club has; empty while unknown (2.11).
  surfaces   Surface[]
  /// Empty while unknown (2.11).
  indoor     IndoorCourts?
  /// Free text: prices differ by hour, season and membership.
  priceInfo  String?       @map("price_info") @db.VarChar(300)
  phone      String?       @db.VarChar(30)
  websiteUrl String?       @map("website_url") @db.VarChar(500)
  /// The club's own booking page — the app has no booking (decision 2026-09-20).
  bookingUrl String?       @map("booking_url") @db.VarChar(500)
  /// When the owner last checked these details at the source. Shown on the
  /// club page so players can tell how fresh the price and phone are.
  verifiedAt DateTime      @map("verified_at") @db.Date

  offers         SparringOffer[]
  outboundClicks OutboundClick[]

  @@map("clubs")
}

/// "Looking for a sparring partner" — a post on the board (Epic 3).
model SparringOffer {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    OfferStatus @default(OPEN)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Deleting a user deletes their offers.
  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Optional: an offer can name only a district. A club that still has
  /// offers can't be deleted — removing a club must be a deliberate step.
  clubId String? @map("club_id") @db.Uuid
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  // Offer fields (task 3.2; model in decisions.md, task 3.1). Ranges and
  // combinations are CHECKs in the migration; the offer schema (3.3)
  // validates first. How many players an offer needs is not stored —
  // playersNeeded() in lib/offers computes it from format and hasPartner.
  format      OfferFormat @default(SINGLES)
  /// Doubles only: the author brings their own partner (a mark, not an account).
  hasPartner  Boolean     @default(false) @map("has_partner")
  /// Stored in UTC, shown in Europe/Warsaw.
  startsAt    DateTime    @map("starts_at") @db.Timestamptz
  /// Set together with a club or on its own; at least one of the two is set.
  /// Empty for an offer at a club outside the city limits.
  district    District?
  /// Wanted NTRP level, 1.5–7.0 in steps of 0.5. Empty — any level.
  ntrpMin     Float?      @map("ntrp_min")
  ntrpMax     Float?      @map("ntrp_max")
  /// Empty — any surface.
  surface     Surface?
  comment     String?     @db.VarChar(500)
  /// Whether the court is already booked (task 3.22). Default: the author
  /// books once a sparring partner is confirmed.
  courtStatus CourtStatus @default(WILL_BOOK) @map("court_status")

  joins          OfferJoin[]
  /// The group thread for a doubles offer (task 3.21): author + accepted players.
  messages       Message[]
  outboundClicks OutboundClick[]

  @@index([authorId])
  @@index([clubId])
  /// The feed's main query: open offers by start time (3.6).
  @@index([status, startsAt])
  @@map("sparring_offers")
}

/// A player's request to join an offer (Epic 3). One per player per offer.
model OfferJoin {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    JoinStatus @default(REQUESTED)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Requests go away with their offer or with the requesting user.
  offerId String        @map("offer_id") @db.Uuid
  offer   SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId  String        @map("user_id") @db.Uuid
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  result   MatchResult?
  /// The private thread for this join (task 3.15): author <-> this player.
  messages Message[]

  @@unique([offerId, userId])
  @@index([userId])
  @@map("offer_joins")
}

/// A chat message, in one of two threads (decision 3.1): private, on a join
/// (author <-> that player), or group, on a doubles offer (author + accepted
/// players, task 3.21). Exactly one of offerJoinId/offerId is set (CHECK).
/// Realtime reads these directly with the user's own session (RLS below),
/// writes go through the server action (3.16).
model Message {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// SYSTEM messages (the thread's welcome note today; more from sessions
  /// 04/06/07) have no sender — CHECK below ties the two together.
  type      MessageType @default(TEXT)

  senderId String? @map("sender_id") @db.Uuid
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  offerJoinId String?    @map("offer_join_id") @db.Uuid
  offerJoin   OfferJoin? @relation(fields: [offerJoinId], references: [id], onDelete: Cascade)

  offerId String?        @map("offer_id") @db.Uuid
  offer   SparringOffer? @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// The real, shorter limit a sender can type is a Zod schema's job (3.16);
  /// this is just an outer bound the database enforces regardless of caller.
  content String @db.VarChar(2000)

  @@index([senderId])
  @@index([offerJoinId])
  @@index([offerId])
  @@map("messages")
}

/// The result of a singles match played through an accepted join (task 4.4;
/// formula and format decided 2026-10-14). Only a CONFIRMED result moves ELO
/// (4.8); PENDING waits for the other side, DISPUTED is frozen for an admin
/// (session 08), NO_SHOW (4.10) is a no-show report nobody disputed within
/// 72h — ELO never moves for one, only the reported player's noShows counter.
model MatchResult {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    MatchResultStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// One result per join. Restrict, not Cascade: results feed ELO history, so
  /// a join with a result — and through it the offer and both users — can't
  /// be deleted until account deletion decides what happens to them (6.15).
  offerJoinId String    @unique @map("offer_join_id") @db.Uuid
  offerJoin   OfferJoin @relation(fields: [offerJoinId], references: [id], onDelete: Restrict)

  /// Sets as played, author's and the joining player's games per set (2-3
  /// entries; shape and tennis-score rules are lib/validation/match-result.ts,
  /// task 4.5 — this column only stores what that schema already approved).
  /// Null for a no-show report (4.10, noShowParty below) — there's no score.
  score         Json?
  /// Who won — the offer's author or the joining player (the same AUTHOR /
  /// PLAYER convention join-transitions.ts uses for who may act). Null for
  /// a no-show report, same as score.
  winner        MatchParty?
  /// Who filed this result; the other party confirms or disputes it (4.7),
  /// or — for a no-show report — is the one the report is about.
  reportedBy    MatchParty  @map("reported_by")
  /// Set only for a no-show report (4.10): who didn't show up, the mirror
  /// of reportedBy (who showed up and filed it). The opponent may dispute
  /// it within 72h (DISPUTED); otherwise the same cron that auto-confirms
  /// scored results settles it as NO_SHOW — never CONFIRMED, since ELO
  /// doesn't move for a no-show (decision 2026-10-14).
  noShowParty   MatchParty? @map("no_show_party")
  /// Set when filed: now + 72h (decision 2026-10-14). Read by the cron job
  /// (5.8) to auto-confirm; kept afterwards only as a record of the deadline.
  autoConfirmAt DateTime    @map("auto_confirm_at") @db.Timestamptz

  /// ELO snapshots (4.8): null until CONFIRMED, set together, exactly once,
  /// in the same transaction that updates both users' rating.
  authorEloBefore Int? @map("author_elo_before")
  authorEloAfter  Int? @map("author_elo_after")
  playerEloBefore Int? @map("player_elo_before")
  playerEloAfter  Int? @map("player_elo_after")

  @@map("match_results")
}

/// A click on a club's booking link or phone number, from `/clubs/[id]` or an
/// offer's page (task 2.13). Logged for the owner's own weekly query, not
/// shown in the app; written outside RLS like every other table (1.2), so
/// there is no SELECT policy either — nobody queries it through the client.
model OutboundClick {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  target    ClickTarget

  /// Null for a guest — the click still counts (task 2.13 works without a
  /// session), it just isn't attributed to anyone.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Set when the click happened on an offer's page, null from a club's own
  /// page — which offer it was doesn't outlive the offer itself.
  offerId String?        @map("offer_id") @db.Uuid
  offer   SparringOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clubId])
  @@index([offerId])
  @@map("outbound_clicks")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

/// The 18 official districts (dzielnice) of Kraków, I–XVIII in order.
/// Display names with Polish letters live in code, not here.
enum District {
  STARE_MIASTO
  GRZEGORZKI
  PRADNIK_CZERWONY
  PRADNIK_BIALY
  KROWODRZA
  BRONOWICE
  ZWIERZYNIEC
  DEBNIKI
  LAGIEWNIKI_BOREK_FALECKI
  SWOSZOWICE
  PODGORZE_DUCHACKIE
  BIEZANOW_PROKOCIM
  PODGORZE
  CZYZYNY
  MISTRZEJOWICE
  BIENCZYCE
  WZGORZA_KRZESLAWICKIE
  NOWA_HUTA

  @@map("district")
}

/// Court surfaces. ARTIFICIAL_GRASS is sand-filled artificial grass, common
/// in Poland; ARTIFICIAL_CLAY is synthetic clay (sztuczna mączka). Offers
/// (3.2) will reuse this enum.
enum Surface {
  CLAY
  ARTIFICIAL_CLAY
  HARD
  ARTIFICIAL_GRASS
  CARPET
  GRASS

  @@map("surface")
}

/// Whether a club has covered courts, and when: some only put up a heated
/// bubble (balon) over outdoor courts for the winter. PARTIAL: some courts
/// are in a hall all year, the rest are outdoor.
enum IndoorCourts {
  NONE
  PARTIAL
  YEAR_ROUND
  WINTER_BUBBLE

  @@map("indoor_courts")
}

enum OfferFormat {
  SINGLES
  DOUBLES

  @@map("offer_format")
}

/// Whether the court for an offer is already booked (task 3.22). BOOKED —
/// the author already has the court; WILL_BOOK — the author books it once a
/// partner is confirmed (the default); ANY — whoever gets there first.
enum CourtStatus {
  BOOKED
  WILL_BOOK
  ANY

  @@map("court_status")
}

/// Past offers are hidden by their start time (3.20), so there is no EXPIRED.
enum OfferStatus {
  OPEN
  FULL
  CANCELLED

  @@map("offer_status")
}

/// TEXT — a participant wrote it; SYSTEM — the app did (e.g. a thread's
/// welcome note, task 3.16), and then senderId is null (CHECK on the table).
enum MessageType {
  TEXT
  SYSTEM

  @@map("message_type")
}

enum JoinStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("join_status")
}

/// Only a CONFIRMED result changes ELO; PENDING waits for the opponent.
/// NO_SHOW (task 4.10) is a no-show report settled with no dispute — it
/// never carries ELO snapshots, unlike CONFIRMED.
enum MatchResultStatus {
  PENDING
  CONFIRMED
  DISPUTED
  NO_SHOW

  @@map("match_result_status")
}

/// What a tracked outbound click (task 2.13) opened: the club's own booking
/// page, or a phone call when the club has no such page.
enum ClickTarget {
  URL
  PHONE

  @@map("click_target")
}

/// Which side of a singles join someone is — the offer's author, or the
/// player who asked to join (task 4.4; same meaning as join-transitions.ts's
/// ACTION_ACTOR). Used for both a result's winner and who filed it.
enum MatchParty {
  AUTHOR
  PLAYER

  @@map("match_party")
}
