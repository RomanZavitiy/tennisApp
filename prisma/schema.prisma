// Database schema. Models are added by the tasks that need them.
// Connection URLs live in prisma.config.ts (CLI) and lib/db.ts (runtime).
//
// Conventions (see .agents/decisions.md, task 0.12):
// - Tables, columns and enums are snake_case in Postgres (@@map / @map), so
//   the SQL we write by hand (RLS policies, Supabase dashboard) needs no quotes.
// - Ids and timestamps have database defaults, so rows inserted outside Prisma
//   (SQL editor, seeds) get them too. User.id is the exception: it is the
//   Supabase auth.users id.
// - Timestamps are timestamptz: stored as UTC, shown in Europe/Warsaw.
// - Every foreign key has an index — Postgres doesn't create one for it.
//
// Started as a skeleton (keys, relations, statuses); domain fields come with
// their own tasks: profile 1.10 (done), club 2.1 (done), offer 3.2/3.10, result 4.4.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A player. One row per Supabase Auth account, created on first sign-in (task 1.9).
model User {
  /// Same value as auth.users.id — set by the app, never generated here.
  /// No foreign key to auth.users: Prisma manages only the public schema.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Profile (task 1.10). The row exists from the first sign-in (1.9), before
  // onboarding, so every field is nullable here; the profile schema (1.11)
  // makes them required. A CHECK in the migration guarantees that a user with
  // onboardingCompletedAt set has all of them.
  /// Mirrors auth.users.email (task 1.9's ensureUserRow sets it on every
  /// sign-in): email fallback (5.1-5.6) needs an address, and app code never
  /// reads auth.users directly — the secret key that could is reserved for
  /// the e2e helper (decision 1.2), plus one narrow exception:
  /// lib/privacy/delete-account.ts calls auth.admin.deleteUser() for a
  /// player deleting their own account (task 6.15, decision 2026-10-16).
  /// Null until the first sign-in after this column existed.
  email                 String?   @unique @db.VarChar(320)
  name                  String?   @db.VarChar(50)
  /// Private: only the age derived from it is ever shown.
  birthDate             DateTime? @map("birth_date") @db.Date
  gender                Gender?
  district              District?
  /// Self-declared NTRP, 1.5–7.0 in steps of 0.5 (CHECK in the migration).
  /// Halves are exact in floating point, so no Decimal is needed. Becomes
  /// the starting point for the ELO rating in Epic 4.
  selfRatedNtrp         Float?    @map("self_rated_ntrp")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz
  /// Path of the profile photo in the "avatars" Storage bucket, always inside
  /// the user's own folder: "{id}/{random}.{ext}" (task 1.14; CHECK in the
  /// migration). Null until a photo is uploaded.
  avatarPath            String?   @map("avatar_path") @db.VarChar(200)
  /// Language for e-mail and push (task 1.20). The page itself always reads
  /// the NEXT_LOCALE cookie, never this column — see decision 2026-10-15
  /// "Польська мова" for why. Set from the language switcher; EN until a
  /// signed-in user changes it.
  locale                Locale    @default(EN)

  // Rating (task 4.2). Set from selfRatedNtrp at onboarding (startingElo,
  // 4.1) and re-set when NTRP changes, until the first confirmed match;
  // from then on only confirmed results move it (4.8). CHECKs in the
  // migration: positive, and set for every onboarded user.
  elo           Int?
  /// Confirmed matches played; 0 means the ELO is still the starting one.
  matchesPlayed Int  @default(0) @map("matches_played")

  // Reliability (tasks 4.10-4.12, decision 2026-10-14 "Надійність гравця").
  // All three are counters, not derived from current state: an accepted
  // join later withdrawn no longer shows ACCEPTED, and no history table
  // records a late cancellation at all, so a query couldn't reconstruct
  // either — same reasoning that already made matchesPlayed a counter.
  /// A singles join reaching ACCEPTED counts as scheduled, win or not —
  /// the reliability percentage's denominator.
  scheduledMatches  Int @default(0) @map("scheduled_matches")
  /// Confirmed no-shows against this player (4.10) — a disputed report
  /// never reaches this counter.
  noShows           Int @default(0) @map("no_shows")
  /// Cancelling an offer, or withdrawing an accepted join, less than 12h
  /// before the start (isLateCancellation, lib/rating/reliability.ts).
  lateCancellations Int @default(0) @map("late_cancellations")

  // Play preferences ("Коли я люблю грати", slice U1, task U1.1). All
  // empty by default and optional in the form (U1.2) — empty means no
  // preference and the current behaviour everywhere that reads them
  // (task U1.3). preferredDays/preferredTimes aren't Postgres enums like
  // District: they're UI-facing string constants (lib/profile/options.ts's
  // WEEKDAYS, lib/offers/feed-filters.ts's TIMES_OF_DAY), validated by Zod
  // rather than a CHECK, the same reasoning `time` already has as a feed
  // filter with no column of its own before this.
  preferredDays      String[]   @map("preferred_days")
  preferredTimes     String[]   @map("preferred_times")
  /// Districts besides `district` above this player is also open to
  /// playing in. A Postgres enum array, same as Club.surfaces.
  preferredDistricts District[] @map("preferred_districts")

  // Notification settings (task 5.3, slice H). All default on: push is the
  // main channel (decision 2026-10-14) and starts silent until 5.15 asks for
  // permission, so defaulting off would mean asking players to find a
  // switch before they ever see a notification.
  /// "Matches & messages": join requests, accept/decline, chat, court
  /// booked, match reminders, result-confirmation nudges.
  notifyMatches       Boolean   @default(true) @map("notify_matches")
  /// "New offers for my level": the matching push from lib/matching (5.16).
  notifyNewOffers     Boolean   @default(true) @map("notify_new_offers")
  /// Whether a missing push subscription falls back to email, for the three
  /// events decision 2026-10-14 names (join request, accepted, confirm
  /// result). Off means those events simply aren't sent without push.
  notifyEmailFallback Boolean   @default(true) @map("notify_email_fallback")
  /// The daily cap on "new offer for my level" pushes (5.16): at most 3,
  /// reset when the Warsaw calendar date changes — a counter like
  /// matchesPlayed, not a query, since nothing else records when a push was
  /// sent (lib/matching/offer-interest.ts).
  offerPushSentOn     DateTime? @map("offer_push_sent_on") @db.Date
  offerPushSentCount  Int       @default(0) @map("offer_push_sent_count")

  // Moderation (tasks 6.1, 6.4, slice I). isAdmin is never written by the
  // app — only SQL or the seed (decision, task 6.1) — and requireAdmin() is
  // the only thing that reads it. blockedAt is set either by the autoblock
  // (3+ reports from different users in 30 days, decision 2026-10-14) or by
  // an admin's "Block player" in the queue (6.3); null means not blocked.
  isAdmin   Boolean   @default(false) @map("is_admin")
  blockedAt DateTime? @map("blocked_at") @db.Timestamptz

  // Legal consent (tasks 6.11, 6.12). Set together at onboarding (the
  // checkbox there); an existing user whose consentVersion doesn't match
  // lib/legal/consent.ts's CURRENT_CONSENT_VERSION — including every user
  // who onboarded before this column existed, consentVersion null — sees
  // /consent on their next page load (requireOnboardedUser).
  consentedAt    DateTime? @map("consented_at") @db.Timestamptz
  consentVersion String?   @map("consent_version") @db.VarChar(20)

  offers                  SparringOffer[]
  joins                   OfferJoin[]
  /// Offers this player hid from their own feed (slice N).
  offerDismissals         OfferDismissal[]
  /// Clubs this player follows (slice O).
  clubFollows             ClubFollow[]
  sentMessages            Message[]
  outboundClicks          OutboundClick[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  reportsFiled            Report[]           @relation("ReportsFiled")
  reportsAgainst          Report[]           @relation("ReportsAgainst")
  adminActionsTaken       AdminAction[]      @relation("AdminActionsTaken")
  adminActionsAgainst     AdminAction[]      @relation("AdminActionsAgainst")
  /// Partner clubs this player is OWNER/STAFF for (slice K).
  clubStaffRoles          ClubStaff[]
  /// Court bookings this player requested.
  bookings                Booking[]          @relation("BookingPlayer")
  /// Bookings this player confirmed or declined, as club staff.
  bookingDecisions        Booking[]          @relation("BookingDecidedBy")
  /// Court blocks this player created, as club staff.
  courtBlocksCreated      CourtBlock[]
  /// Club tips this player filed (slice M).
  clubSubmissionsFiled    ClubSubmission[]   @relation("ClubSubmissionsFiled")
  /// Club tips this admin reviewed (slice M).
  clubSubmissionsReviewed ClubSubmission[]   @relation("ClubSubmissionsReviewed")
  /// Players this player has personally blocked (slice R).
  blocksMade              UserBlock[]        @relation("BlocksMade")
  /// Players who have personally blocked this player (slice R).
  blocksReceived          UserBlock[]        @relation("BlocksReceived")
  /// Invites this player sent, as an offer's author (slice S1).
  invitesSent             OfferInvite[]      @relation("InvitesSent")
  /// Invites this player received (slice S1).
  invitesReceived         OfferInvite[]      @relation("InvitesReceived")
  /// Offers this player is waiting in line for (slice T).
  waitlistEntries         OfferWaitlist[]
  /// This player's "looking for a game" posts (slice U2).
  playIntents             PlayIntent[]
  /// Feedback this player left about an opponent after a match (slice W).
  feedbackGiven           MatchFeedback[] @relation("FeedbackGiven")
  /// Feedback this player received from an opponent after a match (slice W).
  feedbackReceived        MatchFeedback[] @relation("FeedbackReceived")

  // Discoverability (slice S2, task S2.3, owner decision 2026-11-07): whether
  // this player can appear in another author's "candidates to invite" list
  // (lib/matching/candidates.ts). Defaults true — opt-out, not opt-in — and
  // only ever hides what the profile already shows publicly; it isn't a
  // block and doesn't touch the feed or join requests.
  discoverable Boolean @default(true) @map("discoverable")

  @@map("users")
}

/// A browser's web push endpoint for one user (task 5.15). One row per
/// browser/device — a player can have several. Deleted on sign-out (5.15)
/// or when the push service reports it gone (410/404, lib/push).
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service URL the browser gave `pushManager.subscribe()` —
  /// unique by nature (one endpoint is one browser installation), so a
  /// second subscribe from the same browser updates this row instead of
  /// adding a duplicate.
  endpoint String @unique @db.VarChar(500)
  /// The subscription's two keys (RFC 8291), both base64url — stored as the
  /// browser gives them, read back verbatim for `web-push`.
  p256dh   String @db.VarChar(200)
  auth     String @db.VarChar(200)

  @@index([userId])
  @@map("push_subscriptions")
}

/// A tennis club with courts. Filled from hand-checked data (tasks 2.1–2.3).
model Club {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Club fields (task 2.1). Ranges and formats are CHECKs in the migration;
  // the club schema (2.3) validates the data file first.
  /// Stable key from the data file: loading the file again updates the same
  /// row instead of adding a copy (2.3). Lowercase words joined by hyphens.
  slug        String        @unique @db.VarChar(60)
  name        String        @db.VarChar(100)
  address     String        @db.VarChar(200)
  /// Empty for clubs just outside the city limits (Liszki, Giebułtów).
  district    District?
  latitude    Float
  longitude   Float
  courtCount  Int           @map("court_count")
  /// Every surface the club has; empty while unknown (2.11).
  surfaces    Surface[]
  /// Empty while unknown (2.11).
  indoor      IndoorCourts?
  /// Free text: prices differ by hour, season and membership.
  priceInfo   String?       @map("price_info") @db.VarChar(300)
  phone       String?       @db.VarChar(30)
  websiteUrl  String?       @map("website_url") @db.VarChar(500)
  /// The club's own booking page, used while `bookingMode` is EXTERNAL_LINK
  /// (every club until it's onboarded as a booking partner — decision
  /// 2026-10-21).
  bookingUrl  String?       @map("booking_url") @db.VarChar(500)
  /// EXTERNAL_LINK (default): `bookingUrl` is the only way to book, same as
  /// before this epic. SPINBUDDY: the club is a booking partner — courts,
  /// hours and requests (below) are live, and `bookingUrl` stops being shown
  /// (decision 2026-10-21, slice K).
  bookingMode BookingMode   @default(EXTERNAL_LINK) @map("booking_mode")
  /// When the owner last checked these details at the source. Shown on the
  /// club page so players can tell how fresh the price and phone are.
  verifiedAt  DateTime      @map("verified_at") @db.Date

  offers         SparringOffer[]
  outboundClicks OutboundClick[]
  courts         Court[]
  courtHours     CourtHours[]
  staff          ClubStaff[]
  /// Players following this club (slice O).
  follows        ClubFollow[]
  /// The club's chat thread, scoped to followers (session O2).
  messages       Message[]
  /// Coaches who teach here (slice P) — implicit many-to-many, owner-curated
  /// on both sides, loaded the same way as the club itself (task P.2).
  coaches        Coach[]

  @@map("clubs")
}

/// A bookable court at a partner club (`bookingMode = SPINBUDDY`, slice K).
/// Exists for every club regardless of `bookingMode` — courts can be entered
/// ahead of a club going live — but only read by the booking UI once the
/// club is a partner.
model Court {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// "Court 1", "Kort A" — whatever the club itself calls it.
  name            String  @db.VarChar(60)
  surface         Surface
  indoor          Boolean @default(false)
  /// Null means unknown — never invented; shown as "price unknown" rather
  /// than guessed from the club's free-text `priceInfo`.
  pricePerHourPln Int?    @map("price_per_hour_pln")
  /// A court taken out of rotation (renovation, decommissioned) stops
  /// appearing in the booking grid without losing its booking history.
  active          Boolean @default(true)
  /// Display order within the club; ties broken by `name`.
  sortOrder       Int     @default(0) @map("sort_order")

  bookings Booking[]
  blocks   CourtBlock[]

  @@unique([clubId, name])
  @@index([clubId])
  @@map("courts")
}

/// A club's opening hours for one weekday (slice K), shared by all its
/// courts — this app doesn't model a court open on different hours than its
/// siblings. One row per weekday the club is open; a missing weekday is
/// closed that day. `opensAt`/`closesAt` are minutes from midnight on the
/// club's own clock (Europe/Warsaw), e.g. 8:00 = 480.
model CourtHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday (JS `Date#getUTCDay()` convention).
  weekday  Int
  opensAt  Int @map("opens_at")
  closesAt Int @map("closes_at")

  @@unique([clubId, weekday])
  @@index([clubId])
  @@map("court_hours")
}

/// A coach listed in the directory (slice P, task P.2): owner-curated,
/// loaded the same way as `Club` (data file → Zod check → upsert script,
/// task P.1 decision) — no self-registration, no approval queue in v1.
/// Contact goes out by phone or website; no in-app booking, no payments.
model Coach {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Stable key from the data file, same role as `Club.slug`.
  slug       String       @unique @db.VarChar(60)
  name       String       @db.VarChar(100)
  bio        String?      @db.VarChar(600)
  district   District?
  /// Every level this coach teaches; empty is invalid (the loader's schema
  /// requires at least one), same reasoning as `Club.surfaces`.
  levels     CoachLevel[]
  /// Languages this coach teaches in. Reuses `Locale` (EN/PL) rather than a
  /// new enum: the app itself only has two languages, so it already fits
  /// (task P.2 decision).
  languages  Locale[]
  /// Free text: rates differ by lesson length and whether it's private or
  /// group, same reasoning as `Club.priceInfo`.
  priceInfo  String?      @map("price_info") @db.VarChar(300)
  phone      String?      @db.VarChar(30)
  websiteUrl String?      @map("website_url") @db.VarChar(500)
  /// When the owner last checked these details, shown on the page like
  /// `Club.verifiedAt`.
  verifiedAt DateTime     @map("verified_at") @db.Date

  /// Where this coach teaches (implicit many-to-many, task P.2).
  clubs Club[]

  @@map("coaches")
}

/// A player who can act on a partner club's behalf (slice K): confirm or
/// decline booking requests, place blocks. OWNER vs STAFF isn't checked
/// differently anywhere yet — kept apart because a club will eventually
/// manage its own staff list, and only an OWNER should be able to.
model ClubStaff {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  clubId String        @map("club_id") @db.Uuid
  club   Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId String        @map("user_id") @db.Uuid
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   ClubStaffRole @default(STAFF)

  @@unique([clubId, userId])
  @@index([userId])
  @@map("club_staff")
}

/// A player's request to book a court (slice K, v1 — decision 2026-10-21):
/// request-based, no payments. PENDING until a club staff member confirms
/// or declines it; the Postgres EXCLUDE constraint below (added by hand in
/// the migration — Prisma has no syntax for it) is what actually stops two
/// PENDING/CONFIRMED bookings on the same court from overlapping, not
/// application code.
model Booking {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  courtId String @map("court_id") @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  userId  String @map("user_id") @db.Uuid
  user    User   @relation("BookingPlayer", fields: [userId], references: [id], onDelete: Cascade)

  /// Set when the booking was made from an offer's page, so a confirmed
  /// court shows up there too. Null for a booking made on its own.
  offerId String?        @map("offer_id") @db.Uuid
  offer   SparringOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  startsAt DateTime      @map("starts_at") @db.Timestamptz
  endsAt   DateTime      @map("ends_at") @db.Timestamptz
  status   BookingStatus @default(PENDING)

  /// From the player, to the club staff deciding the request.
  note          String? @db.VarChar(300)
  /// From club staff, shown to the player when declined.
  declineReason String? @map("decline_reason") @db.VarChar(300)

  decidedById String?   @map("decided_by_id") @db.Uuid
  decidedBy   User?     @relation("BookingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz

  @@index([courtId])
  @@index([userId])
  @@index([offerId])
  @@map("bookings")
}

/// A court taken out of booking for a stretch of time by club staff
/// (maintenance, a private lesson, a tournament) — slice K. Unlike
/// `Booking`, there's no status: a block always blocks, which is also why
/// its EXCLUDE constraint (migration) has no `WHERE`.
model CourtBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  courtId String @map("court_id") @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt   DateTime @map("ends_at") @db.Timestamptz
  reason   String?  @db.VarChar(300)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([courtId])
  @@map("court_blocks")
}

/// A player's tip about a club not on the platform yet (slice M, task M.1).
/// An inbox, not a publish pipeline: approving a submission (M2) does NOT
/// create a `Club` row by itself — the owner still verifies the details and
/// loads the real club through `prisma/load-clubs.ts` (`clubs:load`), the
/// same "never invent data, always `verifiedAt`" discipline `Club` already
/// documents.
model ClubSubmission {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz
  status    ClubSubmissionStatus @default(PENDING)

  submittedById String @map("submitted_by_id") @db.Uuid
  submittedBy   User   @relation("ClubSubmissionsFiled", fields: [submittedById], references: [id], onDelete: Cascade)

  name          String    @db.VarChar(100)
  address       String    @db.VarChar(200)
  /// The submitter may not know the exact dzielnica.
  districtGuess District? @map("district_guess")
  /// Surfaces, approx court count, contact info the player happens to know.
  notes         String?   @db.VarChar(500)

  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?     @relation("ClubSubmissionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.VarChar(300)

  @@index([submittedById])
  @@index([reviewedById])
  @@map("club_submissions")
}

/// "Looking for a sparring partner" — a post on the board (Epic 3).
model SparringOffer {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    OfferStatus @default(OPEN)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Deleting a user deletes their offers.
  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Optional: an offer can name only a district. A club that still has
  /// offers can't be deleted — removing a club must be a deliberate step.
  clubId String? @map("club_id") @db.Uuid
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  // Offer fields (task 3.2; model in decisions.md, task 3.1). Ranges and
  // combinations are CHECKs in the migration; the offer schema (3.3)
  // validates first. How many players an offer needs is not stored —
  // playersNeeded() in lib/offers computes it from format and hasPartner.
  format          OfferFormat @default(SINGLES)
  /// Doubles only: the author brings their own partner (a mark, not an account).
  hasPartner      Boolean     @default(false) @map("has_partner")
  /// Stored in UTC, shown in Europe/Warsaw.
  startsAt        DateTime    @map("starts_at") @db.Timestamptz
  /// How long the court is wanted for (slice K5): 60, 90, 120 or 180
  /// minutes (CHECK in the migration). Rows from before K5 get the default.
  durationMinutes Int         @default(90) @map("duration_minutes")
  /// Set together with a club or on its own; at least one of the two is set.
  /// Empty for an offer at a club outside the city limits.
  district        District?
  /// Wanted NTRP level, 1.5–7.0 in steps of 0.5. Empty — any level.
  ntrpMin         Float?      @map("ntrp_min")
  ntrpMax         Float?      @map("ntrp_max")
  /// Empty — any surface.
  surface         Surface?
  comment         String?     @db.VarChar(500)
  /// Whether the court is already booked (task 3.22). Default: the author
  /// books once a sparring partner is confirmed.
  courtStatus     CourtStatus @default(WILL_BOOK) @map("court_status")

  // Reminder pushes (task 5.10/5.16, hourly cron): each sent at most once,
  // so an hourly run that catches an offer two hours in a row doesn't
  // double-notify. Null until sent.
  /// ~3h before startsAt, to the author and accepted players.
  matchReminderSentAt DateTime? @map("match_reminder_sent_at") @db.Timestamptz
  /// ~2h after startsAt, "How did the match go?" to the same players.
  howDidItGoSentAt    DateTime? @map("how_did_it_go_sent_at") @db.Timestamptz

  joins          OfferJoin[]
  /// Invites the author sent for this offer (slice S1).
  invites        OfferInvite[]
  /// The group thread for a doubles offer (task 3.21): author + accepted players.
  messages       Message[]
  outboundClicks OutboundClick[]
  /// Reports filed against this offer (task 3.19).
  reports        Report[]
  notifications  Notification[]
  /// A SpinBuddy court booking made for this offer, if any (slice K).
  bookings       Booking[]
  /// Players who hid this offer from their own feed (slice N).
  dismissals     OfferDismissal[]
  /// Players waiting in line while this offer is FULL (slice T).
  waitlist       OfferWaitlist[]

  @@index([authorId])
  @@index([clubId])
  /// The feed's main query: open offers by start time (3.6).
  @@index([status, startsAt])
  @@map("sparring_offers")
}

/// A player's request to join an offer (Epic 3). One per player per offer.
model OfferJoin {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    JoinStatus @default(REQUESTED)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Requests go away with their offer or with the requesting user.
  offerId String        @map("offer_id") @db.Uuid
  offer   SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId  String        @map("user_id") @db.Uuid
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  result        MatchResult?
  /// The private thread for this join (task 3.15): author <-> this player.
  messages      Message[]
  notifications Notification[]

  /// Last time a chat message in this thread triggered a push (task 5.16):
  /// grouped to at most one push per thread per 5 minutes. Null until the
  /// first push.
  lastMessagePushAt DateTime? @map("last_message_push_at") @db.Timestamptz

  /// Set when this request was created by promoting the next person off
  /// the waitlist (slice T, task T.3), not by the player asking directly.
  /// Drives the "from reserve" label and sort order in the author's request
  /// list, and which REQUESTED rows the hourly cron's waitlist timeout
  /// (task T.4) looks at.
  fromWaitlist      Boolean   @default(false) @map("from_waitlist")
  /// When the waitlist promotion above happened — separate from
  /// `createdAt`/`updatedAt`, which a reused (previously withdrawn/
  /// declined) row would carry over from its first creation. Task T.4's
  /// "2h (or 1h) without a reaction" window is measured from here, not
  /// from either of those.
  waitlistOfferedAt DateTime? @map("waitlist_offered_at") @db.Timestamptz

  @@unique([offerId, userId])
  @@index([userId])
  @@map("offer_joins")
}

/// A player invited by an offer's author to join it directly (slice S1,
/// task S1.1) — the author's side of matchmaking, the mirror of OfferJoin's
/// "a player asked". Accepting creates an OfferJoin straight in ACCEPTED
/// (task S1.2, owner decision 2026-11-07): the author already agreed to
/// this player when they sent the invite, so there's no second approval
/// step the way a join request has.
model OfferInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  respondedAt DateTime?    @map("responded_at") @db.Timestamptz

  offerId String        @map("offer_id") @db.Uuid
  offer   SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  inviterId String @map("inviter_id") @db.Uuid
  inviter   User   @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeId String @map("invitee_id") @db.Uuid
  invitee   User   @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  /// Set when this invite was sent from a PlayIntent card (slice U2, task
  /// U2.3) — drives `intent_converted` (task U2.4's analytics table) the
  /// moment the invitee accepts, the one place that funnel can be told
  /// apart from an ordinary "Invite to game" after the fact.
  fromIntent Boolean @default(false) @map("from_intent")

  /// One invite per player per offer (task S1.1) — a declined invite stands,
  /// same reasoning as OfferJoin's own unique index.
  @@unique([offerId, inviteeId])
  @@index([inviteeId])
  @@map("offer_invites")
}

/// "Hide this offer from my feed" (slice N) — no swipe/pass mechanic exists,
/// so this is the faithful equivalent. User-scoped like every other
/// per-user table: a dismissal is only ever read for its own userId, no new
/// RLS judgment call.
model OfferDismissal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  offerId String        @map("offer_id") @db.Uuid
  offer   SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// Leads with userId: the feed's exclusion query is "my dismissals",
  /// same reasoning as OfferJoin's unique index but swapped for this
  /// table's lookup direction.
  @@unique([userId, offerId])
  @@map("offer_dismissals")
}

/// A player's place in line for a FULL offer (slice T, task T.1). Position
/// isn't stored: it's the row's rank by createdAt among the offer's
/// remaining entries, computed where it's shown (lib/offers/waitlist.ts)
/// rather than kept as a column that would need renumbering on every
/// departure. A row is deleted the moment it's promoted (task T.3) or the
/// player leaves (task T.2) — it never lingers as history the way a
/// declined OfferJoin does, since there's nothing to show once it's gone.
model OfferWaitlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  offerId String        @map("offer_id") @db.Uuid
  offer   SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// One waitlist spot per player per offer, same reasoning as OfferJoin's
  /// own unique index.
  @@unique([offerId, userId])
  /// The promotion query's shape: "the earliest entry still waiting" for
  /// one offer.
  @@index([offerId, createdAt])
  @@map("offer_waitlists")
}

/// "Хочу зіграти" (slice U2, task U2.1): a player looking for a game
/// without a concrete offer yet. Visible to every signed-in player (owner
/// decision 2026-11-07), read only on the server — see the RLS note below.
model PlayIntent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The Kraków calendar day this intent is for — a date, not a timestamp,
  /// same convention as Club.verifiedAt.
  date      DateTime    @db.Date
  /// Parts of day (lib/offers/feed-filters.ts's TIMES_OF_DAY), at least
  /// one — validated by Zod, not a Postgres enum, same reasoning as
  /// User.preferredTimes (slice U1).
  times     String[]
  /// Districts this player would play in for this intent, at least one.
  districts District[]
  format    OfferFormat @default(SINGLES)
  /// Free text, e.g. "flexible on time" — the only optional field.
  note      String?     @db.VarChar(200)
  /// Midnight Europe/Warsaw after `date` (task U2.1) — the hourly cron
  /// could prune by this, though nothing does yet; today only the feed
  /// query (lib/offers/play-intent-feed.ts) filters live ones out by date.
  expiresAt DateTime    @map("expires_at") @db.Timestamptz

  /// At most one active intent per day per player (task U2.1): posting
  /// again for the same date replaces it rather than adding a second row.
  @@unique([userId, date])
  /// The feed's own query shape: live intents for one calendar day.
  @@index([date])
  @@map("play_intents")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blockerId String @map("blocker_id") @db.Uuid
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @map("blocked_id") @db.Uuid
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  /// Leads with blockerId: every lookup is "who has this player blocked",
  /// same reasoning as OfferDismissal's unique index above.
  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

/// A player following a club (task O.1-O.2): free, instant, no approval.
/// Scopes club chat (session O2) to followers rather than an open wall —
/// RLS is enabled with no policy below, same as offer_dismissals, since
/// only the server reads/writes this table today; O2's SECURITY DEFINER
/// function reads it as the owner.
model ClubFollow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@map("club_follows")
}

/// A chat message, in one of three threads (decision 3.1, extended
/// 2026-11-01 for session O2): private, on a join (author <-> that player);
/// group, on a doubles offer (author + accepted players, task 3.21); or a
/// club's chat, open to its followers (task O.8). Exactly one of
/// offerJoinId/offerId/clubId is set (CHECK). Realtime reads these directly
/// with the user's own session (RLS below), writes go through the server
/// action (3.16, O.11).
model Message {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// SYSTEM messages (the thread's welcome note today; more from sessions
  /// 04/06/07) have no sender — CHECK below ties the two together.
  type      MessageType @default(TEXT)

  senderId String? @map("sender_id") @db.Uuid
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  offerJoinId String?    @map("offer_join_id") @db.Uuid
  offerJoin   OfferJoin? @relation(fields: [offerJoinId], references: [id], onDelete: Cascade)

  offerId String?        @map("offer_id") @db.Uuid
  offer   SparringOffer? @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// A club's chat (task O.8): any follower may read and write (RLS below).
  clubId String? @map("club_id") @db.Uuid
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// The real, shorter limit a sender can type is a Zod schema's job (3.16);
  /// this is just an outer bound the database enforces regardless of caller.
  content String @db.VarChar(2000)

  /// Reports filed against this message (task 3.19).
  reports Report[]

  @@index([senderId])
  @@index([offerJoinId])
  @@index([offerId])
  @@index([clubId, createdAt])
  @@map("messages")
}

/// The result of a singles match played through an accepted join (task 4.4;
/// formula and format decided 2026-10-14). Only a CONFIRMED result moves ELO
/// (4.8); PENDING waits for the other side, DISPUTED is frozen for an admin
/// (session 08), NO_SHOW (4.10) is a no-show report nobody disputed within
/// 72h — ELO never moves for one, only the reported player's noShows counter.
model MatchResult {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status    MatchResultStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// One result per join. Restrict, not Cascade: results feed ELO history, so
  /// a join with a result — and through it the offer and both users — can't
  /// be deleted until account deletion decides what happens to them (6.15).
  offerJoinId String    @unique @map("offer_join_id") @db.Uuid
  offerJoin   OfferJoin @relation(fields: [offerJoinId], references: [id], onDelete: Restrict)

  /// Sets as played, author's and the joining player's games per set (2-3
  /// entries; shape and tennis-score rules are lib/validation/match-result.ts,
  /// task 4.5 — this column only stores what that schema already approved).
  /// Null for a no-show report (4.10, noShowParty below) — there's no score.
  score                Json?
  /// Who won — the offer's author or the joining player (the same AUTHOR /
  /// PLAYER convention join-transitions.ts uses for who may act). Null for
  /// a no-show report, same as score.
  winner               MatchParty?
  /// Who filed this result; the other party confirms or disputes it (4.7),
  /// or — for a no-show report — is the one the report is about.
  reportedBy           MatchParty  @map("reported_by")
  /// Set only for a no-show report (4.10): who didn't show up, the mirror
  /// of reportedBy (who showed up and filed it). The opponent may dispute
  /// it within 72h (DISPUTED); otherwise the same cron that auto-confirms
  /// scored results settles it as NO_SHOW — never CONFIRMED, since ELO
  /// doesn't move for a no-show (decision 2026-10-14).
  noShowParty          MatchParty? @map("no_show_party")
  /// Set when filed: now + 72h (decision 2026-10-14). Read by the cron job
  /// (5.8) to auto-confirm; kept afterwards only as a record of the deadline.
  autoConfirmAt        DateTime    @map("auto_confirm_at") @db.Timestamptz
  /// Task 5.10: a single "confirm the result" nudge sent ~24h after filing,
  /// to whichever side hasn't settled it yet, while still PENDING. Null
  /// until sent; set by the same hourly cron as the match reminders above.
  resultReminderSentAt DateTime?   @map("result_reminder_sent_at") @db.Timestamptz

  /// ELO snapshots (4.8): null until CONFIRMED, set together, exactly once,
  /// in the same transaction that updates both users' rating.
  authorEloBefore Int?          @map("author_elo_before")
  authorEloAfter  Int?          @map("author_elo_after")
  playerEloBefore Int?          @map("player_elo_before")
  playerEloAfter  Int?          @map("player_elo_after")
  adminActions    AdminAction[]
  /// Post-match feedback either side left about the other (slice W).
  feedback        MatchFeedback[]

  @@map("match_results")
}

/// Optional feedback one player leaves about their opponent after a
/// CONFIRMED result (slice W, owner decision 2026-11-07): up to three tags
/// ("punctual", "level matches NTRP", "good game") plus a separate level
/// signal, once per opponent per match, within 7 days of confirmation (the
/// window is `matchResult.updatedAt` — a result's status only ever
/// transitions to CONFIRMED once, so that timestamp is the confirmation
/// moment). No free text, by design. Tags only ever become a public badge
/// in aggregate (lib/feedback/badges.ts, >=5 different givers); an
/// individual row — and who gave it — is never shown to anyone, including
/// the receiver (enforced by never querying this table by anything other
/// than the giver's own id or an aggregate over receiverId).
model MatchFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  matchResultId String      @map("match_result_id") @db.Uuid
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)

  giverId String @map("giver_id") @db.Uuid
  giver   User   @relation("FeedbackGiven", fields: [giverId], references: [id], onDelete: Cascade)

  receiverId String @map("receiver_id") @db.Uuid
  receiver   User   @relation("FeedbackReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  /// 0-3 entries (CHECK in the migration caps the count; no-duplicates is
  /// the Zod schema's job — Postgres CHECK can't de-dupe without a
  /// subquery) — each tag is its own optional checkbox, not a ranked or
  /// required choice.
  tags FeedbackTag[]
  /// "This player's level felt higher/lower than their declared NTRP" —
  /// deliberately separate from `tags`: it calibrates NTRP (hint only, once
  /// >=3 givers agree — lib/feedback/level-signal.ts), not a politeness tag.
  levelSignal LevelSignal? @map("level_signal")

  /// One feedback row per giver per match — same reasoning as MatchResult's
  /// own unique offerJoinId, but keyed by giver since a match has two
  /// possible givers, not one result.
  @@unique([matchResultId, giverId])
  /// The badge/hint aggregate's own query shape: every feedback a player
  /// has received.
  @@index([receiverId])
  @@map("match_feedback")
}

/// A click on a club's booking link or phone number, from `/clubs/[id]` or an
/// offer's page (task 2.13). Logged for the owner's own weekly query, not
/// shown in the app; written outside RLS like every other table (1.2), so
/// there is no SELECT policy either — nobody queries it through the client.
model OutboundClick {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  target    ClickTarget

  /// Null for a guest — the click still counts (task 2.13 works without a
  /// session), it just isn't attributed to anyone.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Set when the click happened on an offer's page, null from a club's own
  /// page — which offer it was doesn't outlive the offer itself.
  offerId String?        @map("offer_id") @db.Uuid
  offer   SparringOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clubId])
  @@index([offerId])
  @@map("outbound_clicks")
}

/// A player's complaint about an offer, another player, or a chat message
/// (task 3.19). targetUserId is always set — resolved server-side from the
/// offer's author or the message's sender when one of those is the context,
/// never trusted from the client — so the autoblock (6.4) and the admin
/// queue (6.3) always know who a report is about without re-deriving it.
model Report {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  status    ReportStatus @default(OPEN)

  reporterId String @map("reporter_id") @db.Uuid
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String @map("target_user_id") @db.Uuid
  targetUser   User   @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)

  reason  ReportReason
  comment String?      @db.VarChar(500)

  /// Context for the report: at most one of the two is set (CHECK in the
  /// migration) — neither means a direct report against the player, filed
  /// from their profile page.
  offerId   String?        @map("offer_id") @db.Uuid
  offer     SparringOffer? @relation(fields: [offerId], references: [id], onDelete: Cascade)
  messageId String?        @map("message_id") @db.Uuid
  message   Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  adminActions AdminAction[]

  @@index([reporterId])
  @@index([targetUserId])
  @@index([offerId])
  @@index([messageId])
  @@map("reports")
}

/// One moderation action from the admin queue (task 6.3), or the automatic
/// autoblock (6.4, adminId null). Always linked to at least one of reportId/
/// targetUserId/matchResultId (CHECK in the migration) — which ones depend
/// on the action: a report-queue action sets reportId (BLOCK_PLAYER also
/// sets targetUserId, for a blocked-players list that outlives the report);
/// UNBLOCK_PLAYER and the autoblock set only targetUserId; the disputed-
/// results tab sets only matchResultId.
model AdminAction {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  action    AdminActionType
  /// Free text the admin typed, if any — not required: the action type plus
  /// the linked report already say why, most of the time.
  reason    String?         @db.VarChar(500)

  /// Null for the automatic autoblock; otherwise the admin who acted.
  adminId String? @map("admin_id") @db.Uuid
  admin   User?   @relation("AdminActionsTaken", fields: [adminId], references: [id], onDelete: SetNull)

  reportId String? @map("report_id") @db.Uuid
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  targetUserId String? @map("target_user_id") @db.Uuid
  targetUser   User?   @relation("AdminActionsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)

  matchResultId String?      @map("match_result_id") @db.Uuid
  matchResult   MatchResult? @relation(fields: [matchResultId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([reportId])
  @@index([targetUserId])
  @@index([matchResultId])
  @@map("admin_actions")
}

/// One in-app notification: what the bell in the header lists.
/// notify() writes one for every event, before any push/email gating, so a
/// player without push or a real email address still sees what happened.
/// Messages in one thread collapse into a single unread row (refreshed, not
/// added to) so a chat doesn't flood the list.
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  kind      NotificationKind

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Every event is about one offer; it goes away with the offer.
  offerId     String        @map("offer_id") @db.Uuid
  offer       SparringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// NEW_MESSAGE only: the thread, so its messages collapse into one row.
  offerJoinId String?       @map("offer_join_id") @db.Uuid
  offerJoin   OfferJoin?    @relation(fields: [offerJoinId], references: [id], onDelete: Cascade)

  /// Null while unread.
  readAt DateTime? @map("read_at") @db.Timestamptz

  /// The bell's list (newest first) and its unread count.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// One fixed time window's count for one (subject, action) pair (tasks
/// 6.16-6.18). subject is a userId for every action except MAGIC_LINK,
/// which keys by email — there's no session yet at that point, so it's a
/// plain string, not a foreign key. No relation to User: a counter must
/// survive even checks made before a users row exists (MAGIC_LINK), and
/// outliving the counter's own short window is the only cleanup it needs.
model RateLimitCounter {
  subject     String          @db.VarChar(320)
  action      RateLimitAction
  /// The window's start instant — checkRateLimit (lib/rate-limit/) floors
  /// `now` to the action's window length, so every check in the same window
  /// updates the same row instead of adding a new one.
  windowStart DateTime        @map("window_start") @db.Timestamptz
  count       Int             @default(1)

  @@id([subject, action, windowStart])
  @@map("rate_limit_counters")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

/// UI language (task 1.20). Ukrainian comes after launch (decision
/// 2026-10-14), so only two values exist today.
enum Locale {
  EN
  PL

  @@map("locale")
}

/// The 18 official districts (dzielnice) of Kraków, I–XVIII in order.
/// Display names with Polish letters live in code, not here.
enum District {
  STARE_MIASTO
  GRZEGORZKI
  PRADNIK_CZERWONY
  PRADNIK_BIALY
  KROWODRZA
  BRONOWICE
  ZWIERZYNIEC
  DEBNIKI
  LAGIEWNIKI_BOREK_FALECKI
  SWOSZOWICE
  PODGORZE_DUCHACKIE
  BIEZANOW_PROKOCIM
  PODGORZE
  CZYZYNY
  MISTRZEJOWICE
  BIENCZYCE
  WZGORZA_KRZESLAWICKIE
  NOWA_HUTA

  @@map("district")
}

/// Court surfaces. ARTIFICIAL_GRASS is sand-filled artificial grass, common
/// in Poland; ARTIFICIAL_CLAY is synthetic clay (sztuczna mączka). Offers
/// (3.2) will reuse this enum.
enum Surface {
  CLAY
  ARTIFICIAL_CLAY
  HARD
  ARTIFICIAL_GRASS
  CARPET
  GRASS

  @@map("surface")
}

/// Whether a club has covered courts, and when: some only put up a heated
/// bubble (balon) over outdoor courts for the winter. PARTIAL: some courts
/// are in a hall all year, the rest are outdoor.
enum IndoorCourts {
  NONE
  PARTIAL
  YEAR_ROUND
  WINTER_BUBBLE

  @@map("indoor_courts")
}

/// Skill levels a coach teaches (slice P, task P.2). KIDS is its own value
/// rather than a BEGINNER sub-case: a coach for kids isn't necessarily one
/// for adult beginners, and the directory filters on this directly.
enum CoachLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  KIDS

  @@map("coach_level")
}

/// Whether a club's courts can be booked through SpinBuddy, or only
/// externally (decision 2026-10-21, slice K). EXTERNAL_LINK is the default
/// for every club until it's onboarded as a booking partner.
enum BookingMode {
  EXTERNAL_LINK
  SPINBUDDY

  @@map("booking_mode")
}

/// A club staff member's role (slice K). Not yet checked differently
/// anywhere in code — see the ClubStaff model comment.
enum ClubStaffRole {
  OWNER
  STAFF

  @@map("club_staff_role")
}

/// A court booking request's state (slice K). PENDING until club staff
/// decide; CANCELLED is the player's own withdrawal, DECLINED is staff's.
enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED

  @@map("booking_status")
}

enum OfferFormat {
  SINGLES
  DOUBLES

  @@map("offer_format")
}

/// Whether the court for an offer is already booked (task 3.22). BOOKED —
/// the author already has the court; WILL_BOOK — the author books it once a
/// partner is confirmed (the default); ANY — whoever gets there first.
enum CourtStatus {
  BOOKED
  WILL_BOOK
  ANY

  @@map("court_status")
}

/// A club tip's review state (slice M, task M.1). Approving does not create
/// a `Club` row — see the `ClubSubmission` model comment.
enum ClubSubmissionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("club_submission_status")
}

/// Past offers are hidden by their start time (3.20), so there is no EXPIRED.
enum OfferStatus {
  OPEN
  FULL
  CANCELLED

  @@map("offer_status")
}

/// TEXT — a participant wrote it; SYSTEM — the app did (e.g. a thread's
/// welcome note, task 3.16), and then senderId is null (CHECK on the table).
enum MessageType {
  TEXT
  SYSTEM

  @@map("message_type")
}

/// A sent invite's status (slice S1, task S1.1). Mirrors JoinStatus, minus
/// WITHDRAWN: only the invitee acts on an invite (accept/decline); the
/// inviter has nothing to take back once it's sent. EXPIRED is set by the
/// hourly cron once the offer's startsAt passes with no answer.
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("invite_status")
}

enum JoinStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("join_status")
}

/// Only a CONFIRMED result changes ELO; PENDING waits for the opponent.
/// NO_SHOW (task 4.10) is a no-show report settled with no dispute — it
/// never carries ELO snapshots, unlike CONFIRMED. ANNULLED (6.3) is an
/// admin's call on a DISPUTED result (score or no-show alike) that nobody's
/// counters should reflect — the mirror of CONFIRMED/NO_SHOW for a dispute
/// the admin decided wasn't valid.
enum MatchResultStatus {
  PENDING
  CONFIRMED
  DISPUTED
  NO_SHOW
  ANNULLED

  @@map("match_result_status")
}

/// What a tracked outbound click (task 2.13) opened: the club's own booking
/// page, or a phone call when the club has no such page.
enum ClickTarget {
  URL
  PHONE

  @@map("click_target")
}

/// Which side of a singles join someone is — the offer's author, or the
/// player who asked to join (task 4.4; same meaning as join-transitions.ts's
/// ACTION_ACTOR). Used for both a result's winner and who filed it.
enum MatchParty {
  AUTHOR
  PLAYER

  @@map("match_party")
}

/// Why a report was filed (task 3.19). Labels for display live in code
/// (lib/moderation/report-labels.ts), not here.
enum ReportReason {
  NO_SHOW
  ABUSIVE
  FAKE_SPAM
  INAPPROPRIATE
  OTHER

  @@map("report_reason")
}

/// OPEN sits in the admin queue (6.3); DISMISSED and RESOLVED both leave it —
/// the difference is only which action closed it (AdminAction.action), kept
/// for the record, not for anything the app branches on.
enum ReportStatus {
  OPEN
  DISMISSED
  RESOLVED

  @@map("report_status")
}

/// What one AdminAction row did (task 6.3). AUTOBLOCK_PLAYER is the only one
/// a human never takes (AdminAction.adminId is null for it, task 6.4).
enum AdminActionType {
  DISMISS_REPORT
  HIDE_OFFER
  HIDE_MESSAGE
  BLOCK_PLAYER
  UNBLOCK_PLAYER
  AUTOBLOCK_PLAYER
  CONFIRM_RESULT
  ANNUL_RESULT

  @@map("admin_action_type")
}

/// Which mutation a RateLimitCounter row counts (tasks 6.16-6.18).
/// The same kinds as NotificationEvent in lib/notifications/notify.ts.
enum NotificationKind {
  JOIN_REQUESTED
  JOIN_ACCEPTED
  JOIN_DECLINED
  NEW_MESSAGE
  COURT_BOOKED
  MATCH_REMINDER_3H
  HOW_DID_IT_GO
  CONFIRM_RESULT_REMINDER
  NEW_OFFER_FOR_LEVEL
  /// Slice S1 (task S1.3): a player was invited into an offer.
  INVITE_RECEIVED
  /// Slice S1 (task S1.3): an invite the player sent was accepted.
  INVITE_ACCEPTED
  /// Slice T (task T.3): a FULL offer's waitlist reached this player — a
  /// spot just opened up and their priority request is waiting for the
  /// author.
  SPOT_OPENED
  /// Slice U2 (task U2.4): a new "looking for a game" post matches one of
  /// this player's open offers.
  INTENT_FOR_YOUR_OFFER

  @@map("notification_kind")
}

/// The three optional feedback tags a player may leave about an opponent
/// after a confirmed match (slice W, owner decision 2026-11-07) — no free
/// text, and no more than these three.
enum FeedbackTag {
  PUNCTUAL
  LEVEL_MATCHES_NTRP
  GOOD_GAME

  @@map("feedback_tag")
}

/// "This opponent's level felt higher/lower than their declared NTRP"
/// (slice W) — a separate signal from `FeedbackTag`, shown only privately
/// to the player themselves as a hint once enough opponents agree.
enum LevelSignal {
  HIGHER
  LOWER

  @@map("level_signal")
}

enum RateLimitAction {
  NEW_OFFER
  JOIN_REQUEST
  MESSAGE
  REPORT
  MAGIC_LINK
  BOOKING_REQUEST
  /// M.3 (slice M): a player suggesting a club not on the platform yet.
  CLUB_SUBMISSION
  /// S1.5 (slice S1): at most 10 invites an hour, so inviting can't be spammed.
  OFFER_INVITE
  /// U2.1 (slice U2): posting a "looking for a game" intent.
  PLAY_INTENT

  @@map("rate_limit_action")
}
